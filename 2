}
System.out.println("Seat " + seatNumber + " is available.");
}
public static void main(String[] args) {
FlightBooking booking = new FlightBooking();
try {
booking.bookTicket("12345"); // Throws InvalidPassportException
} catch (InvalidPassportException e) {
System.out.println("Error: " + e.getMessage());
}
booking.checkSeat(150); // Throws IllegalArgumentException
}
}
// Custom Exception for invalid passport
class InvalidPassportException extends Exception {
public InvalidPassportException(String message) {
super(message);
}
}
